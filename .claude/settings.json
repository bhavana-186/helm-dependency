{
  "permissions": {
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(gh pr review*)",
      "Bash(gh api -X*)",
      "Bash(gh api --method*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(helm install*)",
      "Bash(helm upgrade*)",
      "Bash(helm uninstall*)",
      "Bash(helm delete*)",
      "Bash(kubectl *)"
    ],
    "ask": [
      "Bash(gh workflow run*)",
      "Bash(git push*)",
      "Bash(gh pr create*)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Bash(helm template*)",
      "Bash(helm lint*)",
      "Bash(helm dependency*)"
    ]
  }
}
